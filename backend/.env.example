LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# Fast conversational model used for casual chat / voice turns (streamed).
# Picks a low-time-to-first-token model so simple queries answer almost
# instantly. Leave empty to fall back to LLM_MODEL for everything.
LLM_FAST_MODEL=openai/gpt-5.4-mini

# Exact origins allowed to call the backend (comma-separated).
# Dev browser + remote origins go here. Never set to "*".
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Regex for UMI local development/desktop origins. The Electron desktop shell
# serves the UI on 127.0.0.1:3456 (port configurable via UMI_FRONTEND_PORT), so
# the port is not fixed. Restricted to localhost only. Set to empty to disable.
CORS_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1)(:\d+)?$

# Phase 2 — Supabase PostgreSQL. Paste the "Session pooler" connection string
# from Dashboard → Project Settings → Database → Connection string. Leave empty
# to run without persistence (chat still works, memory/conversation features
# report 503).
DATABASE_URL=postgresql://postgres.<project_ref>:<db_password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# Supabase project + keys (Dashboard → Project Settings → API). The service
# role key should only ever live on the backend, never ship to the client.
SUPABASE_URL=https://<project_ref>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# The local owner is a real Supabase Auth user (which the scaffold FKs point
# to). Create once via the admin API or Dashboard, then pin the id here.
UMI_OWNER_ID=00000000-0000-0000-0000-000000000001

# Phase 2.5 — ElevenLabs Scribe realtime STT (voice INPUT only). The backend
# mints short-lived single-use tokens for the browser. Voice OUTPUT is local
# speech synthesis via pyttsx3 (see below) — no ElevenLabs/TTS.ai dependency.
ELEVENLABS_API_KEY=

# Local TTS (voice output) via pyttsx3 → macOS system speech. 100% on-machine;
# no API key, no network call, nothing to sign up for. All values optional.
# Voice: any installed macOS system voice id (see "say -v ?" or
# GET /tts/voices). Falls back to the first available English-female voice,
# then the system default. Rate is words-per-minute; volume is 0.0–1.0.
TTS_VOICE=com.apple.voice.compact.en-US.Samantha
TTS_RATE=180
TTS_VOLUME=1.0

# Phase 5 — Gmail. Create a Google Cloud project, enable the Gmail API, build an
# OAuth consent screen ("External"/testing is fine for a personal UMI), create an
# OAuth client of type "Web application", and add the redirect URI below to its
# "Authorized redirect URIs". Paste the client ID/secret here, then connect via
# GET /gmail/auth (the full setup steps are in Phase.md "PHASE 5"). Tokens are
# stored locally at ~/.umi/gmail_token.json (owner-only) — never in the DB.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:8000/gmail/oauth/callback

# Phase 8 — Discord + Telegram. Paste YOUR OWN credentials here; never share
# them in chat or commit them. These are backend-only secrets (backend/.env),
# never exposed to the frontend or browser.
# - Discord: Developer Portal → your App → Bot → build a bot, enable the
#   "Message Content Intent", copy DISCORD_APPLICATION_ID + DISCORD_PUBLIC_KEY
#   (General Information) and the bot token. Your user id: enable Developer
#   Mode (Settings → Advanced), right-click your name → Copy User ID.
# - Telegram: @BotFather → /newbot → copy the token. Your user id: message
#   @userinfobot on Telegram.
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=
DISCORD_OWNER_ID=
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_ID=

# Phase 9 — conversational behavior. Umi may open a conversation after the
# owner has been quiet for UMI_IDLE_THRESHOLD_SECONDS, at most once per
# UMI_IDLE_COOLDOWN_SECONDS, and at most UMI_IDLE_MAX_PROMPTS_PER_HOUR times an
# hour, only between UMI_IDLE_START_HOUR and UMI_IDLE_END_HOUR (local time).
UMI_IDLE_CONVERSATION_ENABLED=1
UMI_IDLE_THRESHOLD_SECONDS=45
UMI_IDLE_COOLDOWN_SECONDS=120
UMI_IDLE_MAX_PROMPTS_PER_HOUR=4
UMI_IDLE_START_HOUR=8
UMI_IDLE_END_HOUR=23
# Seconds after a conversation's creation during which a desktop launch may
# still greet it (once). After that, or after the greeting was already spoken,
# a relaunch stays silent.
UMI_GREETING_WINDOW_SECONDS=90
