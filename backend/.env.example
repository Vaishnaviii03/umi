LLM_API_KEY=
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# Fast conversational model used for casual chat / voice turns (streamed).
# Picks a low-time-to-first-token model so simple queries answer almost
# instantly. Leave empty to fall back to LLM_MODEL for everything.
LLM_FAST_MODEL=openai/gpt-5.4-mini

# Exact origins allowed to call the backend (comma-separated).
# Dev browser + remote origins go here. Never set to "*".
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Regex for UMI local development/desktop origins. The Electron desktop shell
# serves the UI on 127.0.0.1:3456 (port configurable via UMI_FRONTEND_PORT), so
# the port is not fixed. Restricted to localhost only. Set to empty to disable.
CORS_ORIGIN_REGEX=^https?://(localhost|127\.0\.0\.1)(:\d+)?$

# Phase 2 — Supabase PostgreSQL. Paste the "Session pooler" connection string
# from Dashboard → Project Settings → Database → Connection string. Leave empty
# to run without persistence (chat still works, memory/conversation features
# report 503).
DATABASE_URL=postgresql://postgres.<project_ref>:<db_password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require

# Supabase project + keys (Dashboard → Project Settings → API). The service
# role key should only ever live on the backend, never ship to the client.
SUPABASE_URL=https://<project_ref>.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# The local owner is a real Supabase Auth user (which the scaffold FKs point
# to). Create once via the admin API or Dashboard, then pin the id here.
UMI_OWNER_ID=00000000-0000-0000-0000-000000000001

# Phase 2.5 — ElevenLabs text-to-speech (voice output). Get an API key from
# ElevenLabs (Dashboard → API keys). IMPORTANT: the dashboard list shows only
# the key NAME/ID — copy the actual key which starts with "sk_" and is shown
# only once at creation/rotation. Keep it server-side only — never expose it
# in the frontend. Leave empty to disable voice (text chat keeps working).
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=m3yAHyFEFKtbCIM5n7GF
# eleven_turbo_v2_5 is deprecated; eleven_flash_v2_5 is its official
# functional replacement (same languages, lower latency).
ELEVENLABS_MODEL=eleven_flash_v2_5
