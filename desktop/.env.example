# UMI Desktop shell configuration (optional overrides)

# Port the Next.js frontend is served on by the desktop shell
# UMI_FRONTEND_PORT=3456

# Port the Python backend runs on
# UMI_BACKEND_PORT=8000

# User-supplied startup track (local audio file path).
# UMI plays this after the greeting. Leave unset to skip startup music.
# Do NOT bundle copyrighted tracks into the repo.
# UMI_MUSIC_FILE=/Users/<you>/Music/startup.mp3

# Command used to play the startup track (default: afplay on macOS)
# UMI_MUSIC_COMMAND=afplay