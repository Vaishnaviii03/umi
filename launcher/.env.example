# UMI Background Launcher configuration (optional overrides)

# Microphone device index (find with `python -c "import sounddevice; print(sounddevice.query_devices())"`)
# UMI_MIC_DEVICE=

# Sample rate and block size (ms)
# UMI_SAMPLE_RATE=44100
# UMI_BLOCK_MS=20

# Sensitivity 0-100 (higher detects quieter claps)
# UMI_SENSITIVITY=60

# Timing (ms)
# UMI_MIN_GAP_MS=80
# UMI_MAX_INTERVAL_MS=400
# UMI_POST_TRIGGER_COOLDOWN_MS=8000

# Desktop app location (path to the `desktop/` dir)
# UMI_DESKTOP_DIR=/Users/<you>/Umi/desktop